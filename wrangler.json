{
	"name": "astro-blog-starter-template",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "404-page"
	},
	"cache": {
		"enabled": true
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}